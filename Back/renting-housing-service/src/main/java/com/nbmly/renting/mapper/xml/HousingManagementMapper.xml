<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nbmly.renting.mapper.HousingManagementMapper">
    <insert id="saveHousingManagement" useGeneratedKeys="true" keyProperty="id" parameterType="com.nbmly.renting.pojo.HousingManagement">
        INSERT INTO
            housing_management(city_name,housing_title,address,group_name,file_name,rent,state,housing_mode_id,room,hall)
        VALUES
            (#{cityName},#{housingTitle},#{address},#{groupName},#{fileName},#{rent},0,#{housingModeId},#{room},#{hall});
    </insert>

    <update id="updateHousingManagement" parameterType="com.nbmly.renting.pojo.HousingManagement">
        update
            housing_management
        set
            city_name=#{cityName},housing_title=#{housingTitle},address=#{address},
            group_name=#{groupName},file_name=#{fileName},rent=#{rent},
            state=#{state},housing_mode_id=#{housingModeId},room=#{room},
            hall=#{hall}
        where
            id = #{id};
    </update>

    <delete id="deleteHousingManagement">
        DELETE FROM
            housing_management
        WHERE
            id = #{id};
    </delete>
</mapper>